{
	"name": "ragnapax",
	"version": "0.1.0",
	"private": true,
	"description": "Ragnarok point-sharing planner for Tokyo Debunkers",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=26.12.1"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
		"lint": "xo",
		"lint:fix": "xo --fix",
		"lint:reuse": "uvx --from \"reuse[charset-normalizer]==6.2.0\" reuse lint",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "vitest run --config vitest.bench.config.ts",
		"i18n:status": "node scripts/i18n-status.ts"
	},
	"dependencies": {
		"highs": "^1.15.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"xo": "^5.0.1"
	}
}
